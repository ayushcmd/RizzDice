# Rizz Dice — Environment Configuration Example
# Copy this file to .env.local for local backend configuration:
#   cp .env.example .env.local

# Upstash Redis or Local Redis TCP Connection URL
# For Upstash Redis (TLS rediss://):
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST:6379

# For Local Redis (unencrypted redis://):
# REDIS_URL=redis://localhost:6379

# Server Port (default 3001)
PORT=3001
